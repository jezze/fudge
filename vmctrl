#!/bin/bash

set -e

error() {
    echo "Error: ${1}" 2>&1
    exit 1
}

cmd_run() {
    name="default"
    disk=n
    diskname=""
    iso=n
    isoname=""
    network=n
    uefi=n

    while test ${#} -gt 0
    do
        case "${1}" in
            -d)
                disk=y
                diskname="${2}"
                test -f "${diskname}" || error "Disk not found: ${diskname}"
                shift
                ;;
            -i)
                iso=y
                isoname="${2}"
                test -f "${isoname}" || error "ISO not found: ${isoname}"
                shift
                ;;
            -n)
                network=y
                ;;
            -u)
                uefi=y
                ;;
            -*)
                error "Unknown flag: ${1}"
                ;;
            *)
                name="${1}"
                ;;
        esac
        shift
    done

    cmd="qemu-system-x86_64 -nodefaults -enable-kvm -smp 4 -m 128 -vga std -serial stdio"

    if test "${disk}" == "y"
    then
        cmd="${cmd} -drive file=${diskname},format=qcow2,if=ide,index=0"
    else
        cmd="${cmd} -kernel fudge -initrd fudge.cpio,build/root/bin/init"
        test -f fudge || error "Kernel not found. Forgot to build?"
        test -f fudge.cpio || error "Ramdisk not found. Forgot to build?"
    fi

    if test "${iso}" == "y"
    then
        cmd="${cmd} -cdrom fudge.iso"
    fi

    if test "${network}" == "y"
    then
        cmd="${cmd} -device rtl8139,netdev=eth0,bus=pci.0,addr=0x4 -netdev tap,id=eth0,ifname=node-${name}-eth0,script=no,downscript=no"
    fi

    if test "${uefi}" == "y"
    then
        cmd="${cmd} -bios uefi/ovmf.fd"
    fi

    sttybak=$(stty -g)

    echo "Running: ${cmd}"
    echo "Use ctrl+] to kill node-${name}"

    stty intr ^]
    eval "${cmd}"
    stty "${sttybak}"
}

cmd_nat() {
    interface="${1}"

    sysctl -w net.ipv4.conf.all.forwarding=1
    iptables -t nat -A POSTROUTING -o "${interface}" -j MASQUERADE
}

cmd_connect() {
    networks="eth0"
    address="10.0.5.80/24"

    for net in ${networks}
    do
        bridge="bridge-${net}"

        if ! test -e "/sys/class/net/${bridge}"
        then
            ip link add "${bridge}" type bridge
            ip link set "${bridge}" up
            ip addr add "${address}" dev "${bridge}"
        fi

        for interface in $(ls -1 /sys/class/net | grep node-.*-$net)
        do
            ip link set "${interface}" master "${bridge}"
            ip link set "${interface}" up
        done
    done
}

cmd_disconnect() {
    networks="eth0"
    address="10.0.5.80/24"

    for net in ${networks}
    do
        bridge="bridge-${net}"

        for interface in $(ls -1 /sys/class/net | grep node-.*-$net)
        do
            ip link set "${interface}" down
            ip link set "${interface}" nomaster
        done

        if test -e "/sys/class/net/${bridge}"
        then
            ip addr del "${address}" dev "${bridge}"
            ip link set "${bridge}" down
            ip link del "${bridge}" type bridge
        fi
    done
}

cmd_disk_connect() {
    device="/dev/nbd0"
    disk="${1}"

    test -f "${disk}" || error "Disk not found: ${disk}"

    modprobe nbd
    qemu-nbd --connect "${device}" "${disk}"
}

cmd_disk_disconnect() {
    device="/dev/nbd0"

    modprobe nbd
    qemu-nbd --disconnect "${device}"
}

cmd_disk_create() {
    name="fudge"
    format="qcow2"
    disk="${name}.${format}"
    size="5G"

    while test ${#} -gt 0
    do
        case "${1}" in
            -f)
                format="${2}"
                shift
                ;;
            -n)
                name="${2}"
                shift
                ;;
            -s)
                size="${2}"
                shift
                ;;
            -*)
                error "Unknown flag: ${1}"
                ;;
            *)
                name="${1}"
                ;;
        esac
        shift
    done

    echo -n "Creating disk... "
    qemu-img create -q -f "${format}" "${disk}" "${size}"
    echo "done"
}

cmd_disk_setup() {
    device="/dev/nbd0"
    disk="${1}"

    test -f "${disk}" || error "Disk not found: ${disk}"

    partuefi="${device}p1"
    partboot="${device}p2"
    partroot="${device}p3"

    cmd_disk_connect "${1}"

    echo -n "Creating partitions... "
    echo "label: dos" | sfdisk -q "${device}"
    echo ",512M,0xEF,*" | sfdisk -q --append "${device}"
    echo ",512M,0x83" | sfdisk -q --append "${device}"
    echo ",1G,0x83" | sfdisk -q --append "${device}"
    echo "done"

    echo -n "Creating filesystems... "
    mkfs.fat -F 32 "${partuefi}"
    mkfs.ext2 -q "${partboot}"
    mkfs.ext2 -q "${partroot}"
    echo "done"

    rootdir=$(mktemp -d)
    bootdir="${rootdir}/boot"
    uefidir="${bootdir}/efi"

    echo -n "Mount filesystems... "
    mount "${partroot}" "${rootdir}"
    test -d "build/root" && cp -r "build/root/." "${rootdir}"
    mount "${partboot}" "${bootdir}"
    test -d "build/boot" && cp -r "build/boot/." "${bootdir}"
    mount "${partuefi}" "${uefidir}"
    test -d "build/uefi" && cp -r "build/uefi/." "${uefidir}"
    echo "done"

    echo -n "Install GRUB... "
    grub-install --target=i386-pc --boot-directory="${bootdir}" "${device}"
    grub-install --target=x86_64-efi --efi-directory="${uefidir}" --bootloader-id=GRUB --boot-directory="${bootdir}" --removable
    echo "done"

    echo -n "Unmount filesystems... "
    umount -R "${rootdir}"
    echo "done"

    cmd_disk_disconnect
}

cmd_help() {
    echo "Commands:"
    echo "    run [-d <disk>] [-i <iso>] [-n] [<name>]"
    echo "    nat <interface>"
    echo "    connect"
    echo "    disconnect"
    echo "    disk_connect <disk>"
    echo "    disk_disconnect"
    echo "    disk_create [-f <format>] [-n <name>] [-s <size>]"
    echo "    disk_setup <disk>"
}

case "$1" in
run|nat|connect|disconnect|disk_create|disk_connect|disk_disconnect|disk_setup)
    "cmd_$@"
    ;;
*)
    "cmd_help"
    ;;
esac
