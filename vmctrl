#!/bin/bash

set -e

qemu_bin="qemu-system-x86_64"
qemu_flags="-nodefaults -enable-kvm"
qemu_flags_run="-smp 4 -m 128 -kernel fudge -initrd fudge.img -vga std -serial stdio"
qemu_flags_runiso="-smp 4 -m 128 -cdrom fudge.iso -vga std -serial stdio"

error() {
    echo "${1}" 2>&1
    exit 1
}

getdisk() {
    if test -f "disks/node-$1-sda.qcow2"
    then
        echo "-drive file=disks/node-$1-sda.qcow2,format=qcow2,if=ide,index=0"
    fi
}

getnetwork() {
    echo "-device rtl8139,netdev=eth0,bus=pci.0,addr=0x4 -netdev tap,id=eth0,ifname=node-$1-eth0,script=no,downscript=no"
}

run() {
    sttybak=$(stty -g)

    echo "Running: $qemu_bin $qemu_flags $2"
    echo "Use ctrl+] to kill node-$1"

    stty intr ^]
    $qemu_bin $qemu_flags $2
    stty $sttybak
}

cmd_run() {
    run $1 "$qemu_flags_run $(getnetwork $1) $(getdisk $1)"
}

cmd_runsimple() {
    run $1 "$qemu_flags_run $(getdisk $1)"
}

cmd_runiso() {
    run $1 "$qemu_flags_runiso $(getnetwork $1) $(getdisk $1)"
}

cmd_runisosimple() {
    run $1 "$qemu_flags_runiso $(getdisk $1)"
}

cmd_nat() {
    sysctl -w net.ipv4.conf.all.forwarding=1
    iptables -t nat -A POSTROUTING -o $1 -j MASQUERADE
}

cmd_connect() {
    networks="eth0"

    for net in $networks
    do
        bridge="bridge-$net"
        address="10.0.5.80/24"

        if ! test -e /sys/class/net/$bridge
        then
            ip link add $bridge type bridge
            ip link set $bridge up
            ip addr add $address dev $bridge
        fi

        for interface in $(ls -1 /sys/class/net | grep node-.*-$net)
        do
            ip link set $interface master $bridge
            ip link set $interface up
        done
    done
}

cmd_disconnect() {
    networks="eth0"

    for net in $networks
    do
        bridge="bridge-$net"
        address="10.0.5.80/24"

        for interface in $(ls -1 /sys/class/net | grep node-.*-$net)
        do
            ip link set $interface down
            ip link set $interface nomaster
        done

        if test -e /sys/class/net/$bridge
        then
            ip addr del $address dev $bridge
            ip link set $bridge down
            ip link del $bridge type bridge
        fi
    done
}

cmd_disk_connect() {
    test -n "${1}" || error "Missing argument: id"

    disk="disks/node-$1-sda.qcow2"
    device="/dev/nbd0"

    modprobe nbd
    qemu-nbd --connect "${device}" "${disk}"
}

cmd_disk_disconnect() {
    test -n "${1}" || error "Missing argument: id"

    disk="disks/node-$1-sda.qcow2"
    device="/dev/nbd0"

    modprobe nbd
    qemu-nbd --disconnect "${device}"
}

cmd_disk_create() {
    test -n "${1}" || error "Missing argument: id"

    disk="disks/node-$1-sda.qcow2"
    size="5G"

    mkdir -p disks
    echo -n "Creating sda disk... "
    qemu-img create -q -f qcow2 "${disk}" "${size}"
    echo "done"
}

cmd_disk_copy() {
    test -n "${1}" || error "Missing argument: root"
    test -n "${2}" || error "Missing argument: device"

    mnt="disks/mnt"

    mkdir -p "${mnt}"
    mount "${2}" "${mnt}"

    if test -d "${1}"
    then
        cp -r "${1}" "${mnt}"
    fi

    umount "${mnt}"
}

cmd_disk_setup() {
    test -n "${1}" || error "Missing argument: id"

    disk="disks/node-$1-sda.qcow2"
    device="/dev/nbd0"
    partuefi="${device}p1"
    partboot="${device}p2"
    partroot="${device}p3"

    test -f "${disk}" || error "File not found: ${disk}"

    cmd_disk_connect "${1}"
    echo "label: dos" | sfdisk "${device}"
    echo ",512M,0xEF,*" | sfdisk --append "${device}"
    echo ",512M,0x83" | sfdisk --append "${device}"
    echo ",1G,0x83" | sfdisk --append "${device}"
    mkfs.fat -F 32 "${partuefi}"
    mkfs.ext2 "${partboot}"
    mkfs.ext2 "${partroot}"
    cmd_disk_copy "fudge" "${partboot}"
    cmd_disk_copy "initrd.cpio" "${partboot}"
    cmd_disk_copy "build/." "${partroot}"
    cmd_disk_disconnect "${1}"
}

cmd_help() {
    echo "Commands:"
    echo "    run <id>"
    echo "    runiso <id>"
    echo "    runsimple <id>"
    echo "    runisosimple <id>"
    echo "    nat <iface>"
    echo "    connect"
    echo "    disconnect"
    echo "    disk_connect <id>"
    echo "    disk_disconnect"
    echo "    disk_create <id>"
    echo "    disk_setup <id>"
}

case "$1" in
run|runiso|runsimple|runisosimple|nat|connect|disconnect|disk_create|disk_connect|disk_disconnect|disk_setup)
    "cmd_$@"
    ;;
*)
    "cmd_help"
    ;;
esac
