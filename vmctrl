#!/bin/bash

set -e

qemu_bin="qemu-system-x86_64"
qemu_flags="-nodefaults -enable-kvm -smp 4 -m 128 -vga std -serial stdio"

error() {
    echo "${1}" 2>&1
    exit 1
}

getdisk() {
    if test -f "disks/node-$1-sda.qcow2"
    then
        echo "-drive file=disks/node-$1-sda.qcow2,format=qcow2,if=ide,index=0"
    elif test -f "fudge.iso"
    then
        echo "-cdrom fudge.iso"
    else
        echo "-kernel fudge -initrd fudge.cpio,build/root/bin/init"
    fi
}

getnetwork() {
    echo "-device rtl8139,netdev=eth0,bus=pci.0,addr=0x4 -netdev tap,id=eth0,ifname=node-$1-eth0,script=no,downscript=no"
}

run() {
    sttybak=$(stty -g)

    echo "Running: $qemu_bin $qemu_flags $2"
    echo "Use ctrl+] to kill node-$1"

    stty intr ^]
    $qemu_bin $qemu_flags $2
    stty $sttybak
}

cmd_run() {
    run $1 "$(getnetwork $1) $(getdisk $1)"
}

cmd_runsimple() {
    run $1 "$(getdisk $1)"
}

cmd_runiso() {
    run $1 "$(getnetwork $1) $(getdisk $1)"
}

cmd_runisosimple() {
    run $1 "$(getdisk $1)"
}

cmd_nat() {
    sysctl -w net.ipv4.conf.all.forwarding=1
    iptables -t nat -A POSTROUTING -o $1 -j MASQUERADE
}

cmd_connect() {
    networks="eth0"

    for net in $networks
    do
        bridge="bridge-$net"
        address="10.0.5.80/24"

        if ! test -e /sys/class/net/$bridge
        then
            ip link add $bridge type bridge
            ip link set $bridge up
            ip addr add $address dev $bridge
        fi

        for interface in $(ls -1 /sys/class/net | grep node-.*-$net)
        do
            ip link set $interface master $bridge
            ip link set $interface up
        done
    done
}

cmd_disconnect() {
    networks="eth0"

    for net in $networks
    do
        bridge="bridge-$net"
        address="10.0.5.80/24"

        for interface in $(ls -1 /sys/class/net | grep node-.*-$net)
        do
            ip link set $interface down
            ip link set $interface nomaster
        done

        if test -e /sys/class/net/$bridge
        then
            ip addr del $address dev $bridge
            ip link set $bridge down
            ip link del $bridge type bridge
        fi
    done
}

cmd_disk_connect() {
    test -n "${1}" || error "Missing argument: id"

    disk="disks/node-$1-sda.qcow2"
    device="/dev/nbd0"

    modprobe nbd
    qemu-nbd --connect "${device}" "${disk}"
}

cmd_disk_disconnect() {
    test -n "${1}" || error "Missing argument: id"

    disk="disks/node-$1-sda.qcow2"
    device="/dev/nbd0"

    modprobe nbd
    qemu-nbd --disconnect "${device}"
}

cmd_disk_create() {
    test -n "${1}" || error "Missing argument: id"

    disk="disks/node-$1-sda.qcow2"
    size="5G"

    mkdir -p disks
    echo -n "Creating sda disk... "
    qemu-img create -q -f qcow2 "${disk}" "${size}"
    echo "done"
}

cmd_disk_setup() {
    test -n "${1}" || error "Missing argument: id"

    disk="disks/node-$1-sda.qcow2"
    device="/dev/nbd0"
    partuefi="${device}p1"
    partboot="${device}p2"
    partroot="${device}p3"

    test -f "${disk}" || error "File not found: ${disk}"

    cmd_disk_connect "${1}"

    echo -n "Creating partitions... "
    echo "label: dos" | sfdisk -q "${device}"
    echo ",512M,0xEF,*" | sfdisk -q --append "${device}"
    echo ",512M,0x83" | sfdisk -q --append "${device}"
    echo ",1G,0x83" | sfdisk -q --append "${device}"
    echo "done"

    echo -n "Creating filesystems... "
    mkfs.fat -F 32 "${partuefi}"
    mkfs.ext2 -q "${partboot}"
    mkfs.ext2 -q "${partroot}"
    echo "done"

    mkdir -p "disks/mnt"

    echo -n "Mount filesystems... "
    mount "${partroot}" "disks/mnt"
    test -d "build/root" && cp -r "build/root/." "disks/mnt"
    mount "${partboot}" "disks/mnt/boot"
    test -d "build/boot" && cp -r "build/boot/." "disks/mnt/boot"
    mount "${partuefi}" "disks/mnt/boot/efi"
    test -d "build/uefi" && cp -r "build/uefi/." "disks/mnt/boot/efi"
    echo "done"

    echo -n "Install GRUB... "
    grub-install --target=i386-pc --boot-directory=disks/mnt/boot "${device}"
    grub-install --target=x86_64-efi --efi-directory=disks/mnt/boot/efi --bootloader-id=GRUB --boot-directory=disks/mnt/boot
    echo "done"

    echo -n "Unmount filesystems... "
    umount -R "disks/mnt"
    echo "done"

    cmd_disk_disconnect "${1}"
}

cmd_help() {
    echo "Commands:"
    echo "    run <id>"
    echo "    runiso <id>"
    echo "    runsimple <id>"
    echo "    runisosimple <id>"
    echo "    nat <iface>"
    echo "    connect"
    echo "    disconnect"
    echo "    disk_connect <id>"
    echo "    disk_disconnect"
    echo "    disk_create <id>"
    echo "    disk_setup <id>"
}

case "$1" in
run|runiso|runsimple|runisosimple|nat|connect|disconnect|disk_create|disk_connect|disk_disconnect|disk_setup)
    "cmd_$@"
    ;;
*)
    "cmd_help"
    ;;
esac
