#!/bin/bash

set -e

error() {
    echo "Error: ${1}" >&2
    exit 1
}

cmd_run() {
    name="default"
    storage=n
    storagedevice=""
    diskname="fudge.qcow2"
    iso=n
    isoname=""
    network=n
    networkdevice=""
    tap=n
    audio=n
    audiodevice=""
    audiodriver="pa"
    uefi=n
    display=""
    arch="x86"

    while test ${#} -gt 0
    do
        case "${1}" in
            -A)
                audio=y
                ;;
            -a)
                audio=y
                audiodevice="${2}"
                shift
                ;;
            -g)
                display="${2}"
                shift
                ;;
            -d)
                storage=y
                diskname="${2}"
                shift
                ;;
            -i)
                iso=y
                isoname="${2}"
                test -f "${isoname}" || error "ISO not found: ${isoname}"
                shift
                ;;
            -N)
                network=y
                ;;
            -n)
                network=y
                networkdevice="${2}"
                shift
                ;;
            -o)
                audio=y
                audiodriver="${2}"
                shift
                ;;
            -S)
                storage=y
                ;;
            -s)
                storage=y
                storagedevice="${2}"
                shift
                ;;
            -t)
                network=y
                tap=y
                ;;
            -u)
                uefi=y
                ;;
            -x)
                arch="${2}"
                shift
                ;;
            -*)
                error "Unknown flag: ${1}"
                ;;
            *)
                name="${1}"
                ;;
        esac
        shift
    done

    test -z "${display}" || test "${arch}" == "x86" || test "${arch}" == "x86_64" || error "No display choice on ${arch}"

    case "${arch}" in
        x86|x86_64)
            storagedevice="${storagedevice:-virtio}"
            networkdevice="${networkdevice:-virtio}"
            audiodevice="${audiodevice:-ac97}"
            cmd="qemu-system-x86_64 -nodefaults -enable-kvm -smp 4 -m 256 -serial stdio"

            case "${display:-std}" in
                std)
                    cmd="${cmd} -vga std"
                    ;;
                virtio)
                    cmd="${cmd} -vga none -machine i8042=off -device virtio-gpu-pci -device virtio-keyboard-pci -device virtio-mouse-pci"
                    ;;
                *)
                    error "Unknown display: ${display} (std or virtio)"
                    ;;
            esac
            ;;
        arm)
            test "${iso}${audio}${uefi}" == "nnn" || error "No ISO, audio or UEFI on arm"
            storagedevice="${storagedevice:-sd}"
            test "${storagedevice}" == "sd" || error "Unknown storage device on arm: ${storagedevice} (sd)"
            networkdevice="${networkdevice:-smc91c111}"
            test "${networkdevice}" == "smc91c111" || error "Unknown network device on arm: ${networkdevice} (smc91c111)"
            cmd="qemu-system-arm -nodefaults -machine integratorcp -m 256 -audio none -serial stdio -serial vc"
            ;;
        m68k)
            test "${iso}${uefi}" == "nn" || error "No ISO or UEFI on m68k"
            storagedevice="${storagedevice:-virtio}"
            networkdevice="${networkdevice:-virtio}"
            audiodevice="${audiodevice:-virtio}"
            test "${storagedevice}" == "virtio" || error "Unknown storage device on m68k: ${storagedevice} (virtio)"
            test "${networkdevice}" == "virtio" || error "Unknown network device on m68k: ${networkdevice} (virtio)"
            test "${audiodevice}" == "virtio" || error "Unknown audio device on m68k: ${audiodevice} (virtio)"
            cmd="qemu-system-m68k -nodefaults -machine virt -m 256 -serial stdio -global virtio-mmio.force-legacy=false -device virtio-gpu-device -device virtio-keyboard-device -device virtio-mouse-device"
            ;;
        riscv32|riscv64)
            test "${iso}${uefi}" == "nn" || error "No ISO or UEFI on ${arch}"
            storagedevice="${storagedevice:-virtio}"
            networkdevice="${networkdevice:-virtio}"
            audiodevice="${audiodevice:-virtio}"
            test "${storagedevice}" == "virtio" || error "Unknown storage device on ${arch}: ${storagedevice} (virtio)"
            test "${networkdevice}" == "virtio" || error "Unknown network device on ${arch}: ${networkdevice} (virtio)"
            test "${audiodevice}" == "virtio" || error "Unknown audio device on ${arch}: ${audiodevice} (virtio)"
            cmd="qemu-system-${arch} -nodefaults -machine virt -m 256 -device ramfb -device virtio-keyboard-device -device virtio-mouse-device -serial stdio"
            ;;
        *)
            error "Unknown architecture: ${arch} (x86, x86_64, arm, m68k, riscv32 or riscv64)"
            ;;
    esac

    if test "${storage}" == "y"
    then
        test -f "${diskname}" || error "Disk not found: ${diskname}"

        drive="-drive file=${diskname},format=qcow2,if=none,id=disk0"

        case "${storagedevice}" in
            ahci)
                cmd="${cmd} ${drive} -device ahci,id=ahci0 -device ide-hd,drive=disk0,bus=ahci0.0"
                ;;
            ide)
                cmd="${cmd} -drive file=${diskname},format=qcow2,if=ide,index=0"
                ;;
            sd)
                test "${arch}" == "arm" || error "Storage device sd is only on arm"
                cmd="${cmd} -drive file=${diskname},format=qcow2,if=sd"
                ;;
            nvme)
                cmd="${cmd} ${drive} -device nvme,drive=disk0,serial=fudge"
                ;;
            usb)
                cmd="${cmd} ${drive} -device qemu-xhci,id=xhci0 -device usb-storage,drive=disk0,bus=xhci0.0"
                ;;
            virtio)
                if test "${arch}" == "m68k" || test "${arch}" == "riscv32" || test "${arch}" == "riscv64"
                then
                    cmd="${cmd} ${drive} -device virtio-blk-device,drive=disk0"
                else
                    cmd="${cmd} ${drive} -device virtio-blk-pci,drive=disk0"
                fi
                ;;
            *)
                error "Unknown storage device: ${storagedevice} (ahci, ide, nvme, sd, usb or virtio)"
                ;;
        esac
    fi

    if test "${audio}" == "y"
    then
        case "${audiodriver}" in
            wav)
                cmd="${cmd} -audiodev wav,id=audio0,path=fudge.wav"
                ;;
            *)
                cmd="${cmd} -audiodev ${audiodriver},id=audio0"
                ;;
        esac

        case "${audiodevice}" in
            ac97)
                cmd="${cmd} -device AC97,audiodev=audio0"
                ;;
            virtio)
                if test "${arch}" == "m68k" || test "${arch}" == "riscv32" || test "${arch}" == "riscv64"
                then
                    cmd="${cmd} -device virtio-sound-device,audiodev=audio0"
                else
                    cmd="${cmd} -device virtio-sound-pci,audiodev=audio0"
                fi
                ;;
            *)
                error "Unknown audio device: ${audiodevice} (ac97 or virtio)"
                ;;
        esac
    elif test "${arch}" == "m68k" || test "${arch}" == "riscv32" || test "${arch}" == "riscv64"
    then
        cmd="${cmd} -audio none"
    fi

    if test "${iso}" == "y"
    then
        cmd="${cmd} -cdrom ${isoname} -boot d"
    elif test "${storage}" != "y" || test "${arch}" == "arm" || test "${arch}" == "m68k" || test "${arch}" == "riscv32" || test "${arch}" == "riscv64"
    then
        test -f fudge || error "Kernel not found. Forgot to build?"
        test -f fudge.cpio || error "Ramdisk not found. Forgot to build?"

        case "${arch}" in
            x86)
                cmd="${cmd} -kernel fudge -initrd fudge.cpio,build/initrd/bin/init"
                ;;
            x86_64)
                error "qemu can not load a 64-bit kernel, boot from a disk or an ISO (-S, -d or -i)"
                ;;
            arm|m68k|riscv32|riscv64)
                ramdisk=$(sed -n 's/^#define ARCH_RAMDISK_BASE *\(.*ARCH_RAMBASE + \)*\(0x[0-9A-F]*\).*/\2/p' src/kernel/${arch}/arch.h)
                cmd="${cmd} -kernel fudge -device loader,file=fudge.cpio,addr=${ramdisk},force-raw=on"
                ;;
        esac
    fi

    if test "${network}" == "y"
    then
        case "${networkdevice}" in
            rtl8139)
                cmd="${cmd} -device rtl8139,netdev=eth0"
                ;;
            smc91c111)
                test "${arch}" == "arm" || error "Network device smc91c111 is only on arm"
                cmd="${cmd} -net nic,model=smc91c111,netdev=eth0"
                ;;
            virtio)
                if test "${arch}" == "m68k" || test "${arch}" == "riscv32" || test "${arch}" == "riscv64"
                then
                    cmd="${cmd} -device virtio-net-device,netdev=eth0"
                else
                    cmd="${cmd} -device virtio-net-pci,netdev=eth0"
                fi
                ;;
            *)
                error "Unknown network device: ${networkdevice} (rtl8139, smc91c111 or virtio)"
                ;;
        esac

        if test "${tap}" == "y"
        then
            cmd="${cmd} -netdev tap,id=eth0,ifname=node-${name}-eth0,script=no,downscript=no"
        else
            cmd="${cmd} -netdev user,id=eth0,net=10.0.5.0/24,host=10.0.5.80,dhcpstart=10.0.5.1,hostfwd=tcp::8080-:80"
        fi
    fi

    if test "${uefi}" == "y"
    then
        cmd="${cmd} -bios uefi/ovmf.fd"
    fi

    sttybak=$(stty -g)

    echo "Running: ${cmd}"
    echo "Use ctrl+] to kill node-${name}"

    stty intr ^]
    eval "${cmd}"
    stty "${sttybak}"
}

cmd_nat() {
    interface="${1}"

    sysctl -w net.ipv4.conf.all.forwarding=1
    iptables -t nat -A POSTROUTING -o "${interface}" -j MASQUERADE
}

cmd_connect() {
    networks="eth0"
    address="10.0.5.80/24"

    for net in ${networks}
    do
        bridge="bridge-${net}"

        if ! test -e "/sys/class/net/${bridge}"
        then
            ip link add "${bridge}" type bridge
            ip link set "${bridge}" up
            ip addr add "${address}" dev "${bridge}"
        fi

        for interface in $(ls -1 /sys/class/net | grep node-.*-$net)
        do
            ip link set "${interface}" master "${bridge}"
            ip link set "${interface}" up
        done
    done
}

cmd_disconnect() {
    networks="eth0"
    address="10.0.5.80/24"

    for net in ${networks}
    do
        bridge="bridge-${net}"

        for interface in $(ls -1 /sys/class/net | grep node-.*-$net)
        do
            ip link set "${interface}" down
            ip link set "${interface}" nomaster
        done

        if test -e "/sys/class/net/${bridge}"
        then
            ip addr del "${address}" dev "${bridge}"
            ip link set "${bridge}" down
            ip link del "${bridge}" type bridge
        fi
    done
}

cmd_disk_connect() {
    device="/dev/nbd0"
    disk="${1}"

    test -f "${disk}" || error "Disk not found: ${disk}"

    modprobe nbd
    qemu-nbd --connect "${device}" "${disk}" || error "Could not connect: ${disk}"

    while test "$(cat "/sys/block/${device#/dev/}/size")" = "0"
    do
        sleep 0.1
    done
}

cmd_disk_disconnect() {
    device="/dev/nbd0"

    modprobe nbd
    qemu-nbd --disconnect "${device}"
}

cmd_disk_create() {
    name="fudge"
    format="qcow2"
    size="5G"

    while test ${#} -gt 0
    do
        case "${1}" in
            -f)
                format="${2}"
                shift
                ;;
            -n)
                name="${2}"
                shift
                ;;
            -s)
                size="${2}"
                shift
                ;;
            -*)
                error "Unknown flag: ${1}"
                ;;
            *)
                name="${1}"
                ;;
        esac
        shift
    done

    disk="${name}.${format}"

    echo -n "Creating disk... "
    qemu-img create -q -f "${format}" "${disk}" "${size}"
    echo "done"
}

disk_partition_mbr() {
    echo "label: dos" | sfdisk -q "${1}"
    echo ",512M,0xEF,*" | sfdisk -q --append "${1}"
    echo ",512M,0x83" | sfdisk -q --append "${1}"
    echo ",1G,0x83" | sfdisk -q --append "${1}"
}

disk_partition_gpt() {
    sgdisk -o \
        -n 4:2048:+1M -t 4:ef02 -c 4:bios \
        -n 1:0:+512M -t 1:ef00 -c 1:efi \
        -n 2:0:+512M -t 2:8300 -c 2:boot \
        -n 3:0:+1G -t 3:8300 -c 3:root \
        "${1}" > /dev/null
}

disk_setup() {
    device="/dev/nbd0"
    disk="${1}"

    test -f "${disk}" || error "Disk not found: ${disk}"

    partuefi="${device}p1"
    partboot="${device}p2"
    partroot="${device}p3"

    cmd_disk_connect "${1}"

    echo -n "Creating partitions... "
    "disk_partition_${2}" "${device}"
    udevadm settle
    echo "done"

    echo -n "Creating filesystems... "
    mkfs.fat -F 32 "${partuefi}"
    mkfs.ext2 -q "${partboot}"
    mkfs.ext2 -q "${partroot}"
    echo "done"

    rootdir=$(mktemp -d)
    bootdir="${rootdir}/boot"
    uefidir="${bootdir}/efi"

    echo -n "Mount filesystems... "
    mount "${partroot}" "${rootdir}"
    test -d "build/root" && cp -r "build/root/." "${rootdir}"
    mount "${partboot}" "${bootdir}"
    test -d "build/boot" && cp -r "build/boot/." "${bootdir}"
    mount "${partuefi}" "${uefidir}"
    test -d "build/uefi" && cp -r "build/uefi/." "${uefidir}"
    echo "done"

    echo -n "Install GRUB... "
    grub-install --target=i386-pc --boot-directory="${bootdir}" "${device}"
    grub-install --target=x86_64-efi --efi-directory="${uefidir}" --bootloader-id=GRUB --boot-directory="${bootdir}" --removable
    echo "done"

    echo -n "Unmount filesystems... "
    umount -R "${rootdir}"
    echo "done"

    cmd_disk_disconnect
}

cmd_disk_setup() {
    disk_setup "${1}" mbr
}

cmd_disk_setup_gpt() {
    disk_setup "${1}" gpt
}

cmd_disk_setup_amiga() {
    disk="${1}"
    files=""

    test -f "${disk}" || error "Disk not found: ${disk}"
    qemu-img info "${disk}" | grep -q "^file format: raw$" || error "Disk is not raw: ${disk}"
    test -f "fs-uae/hd/fudgeboot" || error "fudgeboot not found, build with make m68k-amiga"
    command -v rdbtool > /dev/null || error "rdbtool not found, install amitools"

    for file in fs-uae/hd/*
    do
        files="${files} + write ${file}"
    done

    echo -n "Creating partitions... "
    rdbtool "${disk}" init + add size=100% dostype=DOS1 bootable=1 name=DH0 > /dev/null
    echo "done"

    echo -n "Creating filesystems... "
    xdftool "${disk}" open part=DH0 + format Fudge ffs ${files} > /dev/null
    echo "done"
}

cmd_help() {
    echo "Commands:"
    echo "    run [-S] [-s <storage>] [-d <disk>] [-N] [-n <network>] [-t] [-A] [-a <audio>] [-o <audio driver>] [-g <display>] [-i <iso>] [-u] [-x <arch>] [<name>]"
    echo "        -S, -N, -A enable storage, network and audio"
    echo "        -s ahci, ide, nvme, usb or virtio (default virtio, disk fudge.qcow2), sd on arm (the only one there)"
    echo "        -n rtl8139 or virtio (default virtio, qemu user networking, -t for tap), smc91c111 on arm (the only one there)"
    echo "        -a ac97 or virtio (default ac97, virtio on m68k and riscv, none on arm), -o pa, pipewire, alsa or wav (default pa)"
    echo "        -g std or virtio (default std; virtio also swaps PS/2 for a virtio keyboard and mouse), x86 only"
    echo "        -x x86, x86_64, arm, m68k, riscv32 or riscv64 (default x86; arm has kernel debug output on the second serial port, in qemu's window)"
    echo "    nat <interface>"
    echo "    connect"
    echo "    disconnect"
    echo "    disk_connect <disk>"
    echo "    disk_disconnect"
    echo "    disk_create [-f <format>] [-n <name>] [-s <size>]"
    echo "    disk_setup <disk>"
    echo "    disk_setup_gpt <disk>"
    echo "    disk_setup_amiga <disk>"
    echo "        raw disk, gets a rigid disk block and a bootable FFS partition with fs-uae/hd (needs amitools)"
}

case "$1" in
run|nat|connect|disconnect|disk_create|disk_connect|disk_disconnect|disk_setup|disk_setup_gpt|disk_setup_amiga)
    "cmd_$@"
    ;;
*)
    "cmd_help"
    ;;
esac
