{
  general:
  {
    layout: default
    background: "initrd:data/fudge.pcx"
  }
  localization:
  {
    language: en_US
    timezone: UTC
  }
  screen:
  {
    resolution:
    {
      width: 1920
      height: 1080
      bpp: 4
    }
  }
  keyboard:
  {
    map: "initrd:data/keys/en_US.mq"
  }
  mouse:
  {
    speed: 4
  }
  bindings:
  [
    { key: q mod: alt+shift action: close }
    { key: p mod: alt+shift action: run command: "initrd:bin/wshell" }
    { key: k mod: alt action: next }
    { key: j mod: alt action: previous }
    { key: enter mod: alt action: swap }
    { key: pageup mod: none action: scrollup }
    { key: pagedown mod: none action: scrolldown }
    { key: tab mod: none action: focusnext }
    { key: tab mod: shift action: focusprevious }
    { key: a mod: ctrl action: markall }
    { key: c mod: ctrl action: copy }
    { key: x mod: ctrl action: cut }
    { key: v mod: ctrl action: paste }
  ]
  colors:
  [
    { name: button-normal-shadow      value: E8101010 }
    { name: button-normal-body        value: E8484848 }
    { name: button-normal-dark        value: E8404040 }
    { name: button-normal-light       value: E8888888 }
    { name: button-normal-text        value: E8FFFFFF }
    { name: button-normal-icon        value: E8FFFFFF }
    { name: button-hover-shadow       value: E8101010 }
    { name: button-hover-body         value: E8505050 }
    { name: button-hover-dark         value: E8484848 }
    { name: button-hover-light        value: E8888888 }
