{
  general:
  {
    layout: default
    background: "initrd:data/fudge.pcx"
  }
  localization:
  {
    language: en_US
    timezone: UTC
  }
  screen:
  {
    resolution:
    {
      width: 1920
      height: 1080
      bpp: 4
    }
  }
  keyboard:
  {
    map: "initrd:data/keys/en_US.mq"
  }
  mouse:
  {
    speed: 4
  }
  bindings: "initrd:data/config/wm-bindings.mq"
  theme: "initrd:data/config/wm-theme-default.mq"
}
