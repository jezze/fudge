{
  general:
  {
    layout: default
  }
  localization:
  {
    language: en_US
    time: en_US
    timezone: UTC
  }
  screen:
  {
    resolution:
    {
      width: 1920
      height: 1080
      bpp: 4
    }
  }
  keyboard:
  {
    layout: qwerty_US
  }
  mouse:
  {
    speed: 4
    acceleration: false
  }
  bindings:
  [
    { key: q mod: alt+shift action: close }
    { key: p mod: alt+shift action: run command: "initrd:bin/wshell" }
    { key: k mod: alt action: next }
    { key: j mod: alt action: previous }
    { key: enter mod: alt action: swap }
    { key: pageup mod: none action: scrollup }
    { key: pagedown mod: none action: scrolldown }
    { key: tab mod: none action: focusnext }
    { key: tab mod: shift action: focusprevious }
  ]
  colors:
  [
    { name: button-shadow           value: E8101010 }
    { name: button-body             value: E8484848 }
    { name: button-dark             value: E8404040 }
    { name: button-light            value: E8888888 }
    { name: button-hover-shadow     value: E8101010 }
    { name: button-hover-body       value: E8505050 }
    { name: button-hover-dark       value: E8484848 }
    { name: button-hover-light      value: E8888888 }
    { name: button-focus-shadow     value: E8101010 }
    { name: button-focus-body       value: E8585858 }
    { name: button-focus-dark       value: E8505050 }
    { name: button-focus-light      value: E8888888 }
    { name: button-label            value: E8FFFFFF }
    { name: checkbox-shadow         value: E8101010 }
    { name: checkbox-body           value: E8484848 }
    { name: checkbox-dark           value: E8404040 }
    { name: checkbox-light          value: E8888888 }
    { name: checkbox-hover-shadow   value: E8101010 }
    { name: checkbox-hover-body     value: E8505050 }
    { name: checkbox-hover-dark     value: E8484848 }
    { name: checkbox-hover-light    value: E8888888 }
    { name: checkbox-focus-shadow   value: E8101010 }
    { name: checkbox-focus-body     value: E8585858 }
    { name: checkbox-focus-dark     value: E8505050 }
    { name: checkbox-focus-light    value: E8888888 }
    { name: checkbox-icon           value: E8FFFFFF }
    { name: field-shadow            value: E8101010 }
    { name: field-body              value: E82A2A2A }
    { name: field-dark              value: E8101010 }
    { name: field-light             value: E8686868 }
    { name: field-hover-shadow      value: E8101010 }
    { name: field-hover-body        value: E82A2A2A }
    { name: field-hover-dark        value: E8101010 }
    { name: field-hover-light       value: E8787878 }
    { name: field-focus-shadow      value: E8101010 }
    { name: field-focus-body        value: E82A2A2A }
    { name: field-focus-dark        value: E8101010 }
    { name: field-focus-light       value: E8888888 }
    { name: frame-shadow            value: E8101010 }
    { name: frame-body              value: 00000000 }
    { name: frame-dark              value: E8101010 }
    { name: frame-light             value: E8686868 }
    { name: frame-title             value: E8E0E0E0 }
    { name: item-shadow             value: 00242424 }
    { name: item-body               value: 00242424 }
    { name: item-dark               value: 00242424 }
    { name: item-light              value: 00242424 }
    { name: item-hover-shadow       value: E8242424 }
    { name: item-hover-body         value: E8242424 }
    { name: item-hover-dark         value: E8242424 }
    { name: item-hover-light        value: E8242424 }
    { name: item-focus-shadow       value: E81A1A1A }
    { name: item-focus-body         value: E81A1A1A }
    { name: item-focus-dark         value: E81A1A1A }
    { name: item-focus-light        value: E81A1A1A }
    { name: link                    value: E8C07878 }
    { name: mouse-shadow            value: E8101010 }
    { name: mouse-body              value: E8202020 }
    { name: mouse-dark              value: 00000000 }
    { name: mouse-light             value: E8F0F0F0 }
    { name: panel-shadow            value: E8101010 }
    { name: panel-body              value: E8303030 }
    { name: panel-dark              value: E8303030 }
    { name: panel-light             value: E8585858 }
    { name: select-focus-shadow     value: E8101010 }
    { name: select-focus-body       value: E8805050 }
    { name: select-focus-dark       value: E8805050 }
    { name: select-focus-light      value: E8E0B0B0 }
    { name: select-icon             value: E8FFFFFF }
    { name: select-label            value: E8FFFFFF }
    { name: text                    value: E8E0E0E0 }
    { name: window-shadow           value: E8101010 }
    { name: window-body             value: E8805050 }
    { name: window-dark             value: E8805050 }
    { name: window-light            value: E8E0B0B0 }
    { name: window-icon             value: A8FFFFFF }
    { name: window-icon-hover       value: E8FFFFFF }
    { name: window-title            value: E8FFFFFF }
  ]
}
