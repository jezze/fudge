{
  general:
  {
    layout: default
    theme: "initrd:data/config/wm-theme-default.mq"
    background: "initrd:data/fudge.pcx"
    transparency: on
  }
  localization:
  {
    language: en_US
    timezone: UTC
  }
  displays:
  [
    { device: video:0 width: 1920 height: 1080 bpp: 4 }
    { device: video:1 width: 1920 height: 1080 bpp: 4 }
  ]
  keyboards:
  [
    { device: keyboard:0 map: "initrd:data/keys/en_US.mq" }
  ]
  mice:
  [
    { device: mouse:0 speed: 4 }
    { device: mouse:1 speed: 4 }
  ]
  touchpads:
  [
    { device: touch:0 doubletap: drag }
  ]
  bindings: "initrd:data/config/wm-bindings.mq"
}
