+ fill color "FF202020"
+ layout id "desktop" flow "vertical"
+ layout id "menu" in "desktop" flow "horizontal"
+ select id "fudge-select" in "menu" label "Fudge"
+ panel id "fudge-layout" in "fudge-select" flow "vertical-stretch" padding "4"
+ item id "fudge-about" in "fudge-layout" padding "16" onclick "run=initrd:bin/wabout"
+ text in "fudge-about" label "About"
+ item id "fudge-settings" in "fudge-layout" padding "16" onclick "run=initrd:bin/wsettings"
+ text in "fudge-settings" label "Settings"
+ item id "fudge-reboot" in "fudge-layout" padding "16" onclick "run=initrd:bin/reboot"
+ text in "fudge-reboot" label "Reboot"
+ select id "apps-select" in "menu" label "Apps"
+ panel id "apps-layout" in "apps-select" flow "vertical-stretch" padding "4"
+ item id "apps-shell" in "apps-layout" padding "16" onclick "run=initrd:bin/wshell"
+ text in "apps-shell" label "Shell"
+ item id "apps-filemanager" in "apps-layout" padding "16" onclick "run=initrd:bin/wfile"
+ text in "apps-filemanager" label "File Manager"
+ item id "apps-calculator" in "apps-layout" padding "16" onclick "run=initrd:bin/wcalc"
+ text in "apps-calculator" label "Calculator"
+ item id "apps-test" in "apps-layout" padding "16" onclick "run=initrd:bin/wtest"
+ text in "apps-test" label "Test"
