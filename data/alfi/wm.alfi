+ fill color "FF202020"
+ image id "mouse" mimetype "image/fudge-icon-mouse" display "fixed"
+ layout id "desktop" flow "vertical"
+ layout id "menu" in "desktop" flow "horizontal"
+ select id "fudge-select" in "menu" label "Fudge"
+ layout id "fudge-layout" in "fudge-select" flow "vertical-stretch"
+ choice in "fudge-layout" label "About" onclick "run=initrd:bin/wabout"
+ choice in "fudge-layout" label "Settings" onclick "run=initrd:bin/wsettings"
+ choice in "fudge-layout" label "Reboot" onclick "run=initrd:bin/reboot"
+ select id "apps-select" in "menu" label "Apps"
+ layout id "apps-layout" in "apps-select" flow "vertical-stretch"
+ choice in "apps-layout" label "Shell" onclick "run=initrd:bin/wshell"
+ choice in "apps-layout" label "File Manager" onclick "run=initrd:bin/wfile"
+ choice in "apps-layout" label "Calculator" onclick "run=initrd:bin/wcalc"
+ choice in "apps-layout" label "Test" onclick "run=initrd:bin/wtest"
