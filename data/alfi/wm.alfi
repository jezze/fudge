+ media id "background" source "mem:background"
+ layout id "desktop" flow "vertical-stretch"
+ layout id "menu" in "desktop" flow "horizontal-stretch"
+ select id "fudge-select" in "menu" label "Fudge"
+ panel id "fudge-layout" in "fudge-select" flow "vertical-stretch"
+ each id "fudge" in "fudge-layout" data "fudge" flow "vertical-stretch"
+ item id "fudge-item" in "fudge" padding "4" onclick "run={run}"
+ text in "fudge-item" label "{label}"
+ select id "apps-select" in "menu" label "Apps"
+ panel id "apps-layout" in "apps-select" flow "vertical-stretch"
+ each id "apps" in "apps-layout" data "apps" flow "vertical-stretch"
+ item id "apps-item" in "apps" padding "4" onclick "run={run}"
+ text in "apps-item" label "{label}"
+ select id "games-select" in "menu" label "Games"
+ panel id "games-layout" in "games-select" flow "vertical-stretch"
+ each id "games" in "games-layout" data "games" flow "vertical-stretch"
+ item id "games-item" in "games" padding "4" onclick "run={run}"
+ text in "games-item" label "{label}"
+ select id "hosts-select" in "menu" label "Hosts"
+ panel id "hosts-layout" in "hosts-select" flow "vertical-stretch"
+ each id "hosts" in "hosts-layout" data "hosts" flow "vertical-stretch"
+ item id "hosts-item" in "hosts" padding "4" onclick "run={run}"
+ text in "hosts-item" label "{label}"
+ layout id "menu-space" in "menu" span "1"
+ panel id "clock-panel" in "menu" padding "3"
+ text id "clock" in "clock-panel" label "--:-- --"
@ fudge about run "initrd:bin/wabout" label "About"
@ fudge settings run "initrd:bin/wsettings" label "Settings"
@ fudge reboot run "initrd:bin/reboot" label "Reboot"
@ fudge shutdown run "initrd:bin/shutdown" label "Shutdown"
@ apps shell run "initrd:bin/wshell" label "Shell"
@ apps filemanager run "initrd:bin/wfile" label "File Manager"
@ apps texteditor run "initrd:bin/wedit" label "Text Editor"
@ apps imageviewer run "initrd:bin/wimage" label "Image Viewer"
@ apps browser run "root:bin/browser" label "Browser"
@ apps calculator run "initrd:bin/wcalc" label "Calculator"
@ games doom run "root:bin/doom" label "Doom"
@ games pop run "root:bin/pop" label "Prince of Persia"
@ games nes run "initrd:bin/wfile -mode select -command root:bin/nes" label "NES"
@ games snes run "initrd:bin/wfile -mode select -command root:bin/snes" label "SNES"
@ games gameboy run "initrd:bin/wfile -mode select -command root:bin/gameboy" label "Gameboy"
@ hosts connect run "initrd:bin/wconnect" label "Connect..."
@ hosts hello run "initrd:bin/wconnect -url http://tools.fudgeos.com/hello.alfi" label "Hello World (fudgeos.com)"
