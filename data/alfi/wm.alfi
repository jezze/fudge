+ image id "background" source "mem:background"
+ layout id "desktop" flow "vertical"
+ layout id "menu" in "desktop" flow "horizontal"
+ select id "fudge-select" in "menu" label "Fudge"
+ panel id "fudge-layout" in "fudge-select" flow "vertical-stretch"
+ item id "fudge-about" in "fudge-layout" padding "4" onclick "run=initrd:bin/wabout"
+ text in "fudge-about" label "About"
+ item id "fudge-settings" in "fudge-layout" padding "4" onclick "run=initrd:bin/wsettings"
+ text in "fudge-settings" label "Settings"
+ item id "fudge-reboot" in "fudge-layout" padding "4" onclick "run=initrd:bin/reboot"
+ text in "fudge-reboot" label "Reboot"
+ select id "apps-select" in "menu" label "Apps"
+ panel id "apps-layout" in "apps-select" flow "vertical-stretch"
+ item id "apps-shell" in "apps-layout" padding "4" onclick "run=initrd:bin/wshell"
+ text in "apps-shell" label "Shell"
+ item id "apps-filemanager" in "apps-layout" padding "4" onclick "run=initrd:bin/wfile"
+ text in "apps-filemanager" label "File Manager"
+ item id "apps-texteditor" in "apps-layout" padding "4" onclick "run=initrd:bin/wedit"
+ text in "apps-texteditor" label "Text Editor"
+ item id "apps-imageviewer" in "apps-layout" padding "4" onclick "run=initrd:bin/wimage"
+ text in "apps-imageviewer" label "Image Viewer"
+ item id "apps-calculator" in "apps-layout" padding "4" onclick "run=initrd:bin/wcalc"
+ text in "apps-calculator" label "Calculator"
+ select id "games-select" in "menu" label "Games"
+ panel id "games-layout" in "games-select" flow "vertical-stretch"
+ item id "games-doom" in "games-layout" padding "4" onclick "run=initrd:bin/doom"
+ text in "games-doom" label "Doom"
+ item id "games-pop" in "games-layout" padding "4" onclick "run=initrd:bin/pop"
+ text in "games-pop" label "Prince of Persia"
+ select id "hosts-select" in "menu" label "Hosts"
+ panel id "hosts-layout" in "hosts-select" flow "vertical-stretch"
+ item id "hosts-connect" in "hosts-layout" padding "4" onclick "run=initrd:bin/wconnect"
+ text in "hosts-connect" label "Connect..."
+ item id "hosts-hello" in "hosts-layout" padding "4" onclick "run=initrd:bin/wconnect -url http://tools.fudgeos.com/hello.alfi"
+ text in "hosts-hello" label "Hello World (fudgeos.com)"
