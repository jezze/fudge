+ window id "window" label "Image"
+ panel id "base" in "window" flow "vertical-stretch" padding "12" spacing "8" span "1"
+ layout id "top" in "base" flow "horizontal" spacing "8"
+ select id "mode" in "top" label "Normal" onselect "q=mode&mode="
+ panel id "mode-list" in "mode" flow "vertical-stretch" padding "4"
+ item id "mode-normal" in "mode-list" padding "16"
+ text in "mode-normal" label "Normal"
+ item id "mode-stretched" in "mode-list" padding "16"
+ text in "mode-stretched" label "Stretched"
+ item id "mode-filled" in "mode-list" padding "16"
+ text in "mode-filled" label "Filled"
+ listbox id "frame" in "base" mode "readonly" flow "vertical-stretch" span "1"
