+ window id "window" label "Settings"
+ panel id "base" in "window" flow "vertical-stretch" padding "12" spacing "8" span "1"
+ layout id "top" in "base" flow "horizontal" spacing "8"
+ select id "area" in "top" label "General"
+ panel id "area-list" in "area" flow "vertical-stretch" padding "4"
+ item id "area-general" in "area-list" padding "16" onclick "q=area&name=general"
+ text in "area-general" label "General"
+ item id "area-localization" in "area-list" padding "16" onclick "q=area&name=localization"
+ text in "area-localization" label "Localization"
+ item id "area-screen" in "area-list" padding "16" onclick "q=area&name=screen"
+ text in "area-screen" label "Screen"
+ item id "area-keyboard" in "area-list" padding "16" onclick "q=area&name=keyboard"
+ text in "area-keyboard" label "Keyboard"
+ item id "area-mouse" in "area-list" padding "16" onclick "q=area&name=mouse"
+ text in "area-mouse" label "Mouse"
+ item id "area-bindings" in "area-list" padding "16" onclick "q=area&name=bindings"
+ text in "area-bindings" label "Bindings"
+ item id "area-colors" in "area-list" padding "16" onclick "q=area&name=colors"
+ text in "area-colors" label "Colors"
+ listbox id "content" in "base" mode "readonly" flow "vertical-stretch" padding "8" overflow "scroll" span "1"
