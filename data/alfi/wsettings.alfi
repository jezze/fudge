+ window id "window" label "Settings"
+ panel id "base" in "window" flow "vertical-stretch" padding "2" spacing "2" span "1"
+ layout id "top" in "base" flow "horizontal" spacing "2"
+ select id "area" in "top" label "General"
+ panel id "area-list" in "area" flow "vertical-stretch"
+ item id "area-general" in "area-list" padding "4" onclick "q=area&name=general"
+ text in "area-general" label "General"
+ item id "area-localization" in "area-list" padding "4" onclick "q=area&name=localization"
+ text in "area-localization" label "Localization"
+ item id "area-video" in "area-list" padding "4" onclick "q=area&name=video"
+ text in "area-video" label "Video"
+ item id "area-audio" in "area-list" padding "4" onclick "q=area&name=audio"
+ text in "area-audio" label "Audio"
+ item id "area-keyboard" in "area-list" padding "4" onclick "q=area&name=keyboard"
+ text in "area-keyboard" label "Keyboard"
+ item id "area-mouse" in "area-list" padding "4" onclick "q=area&name=mouse"
+ text in "area-mouse" label "Mouse"
+ item id "area-touch" in "area-list" padding "4" onclick "q=area&name=touch"
+ text in "area-touch" label "Touch"
+ item id "area-network" in "area-list" padding "4" onclick "q=area&name=network"
+ text in "area-network" label "Network"
+ item id "area-bindings" in "area-list" padding "4" onclick "q=area&name=bindings"
+ text in "area-bindings" label "Bindings"
+ item id "area-colors" in "area-list" padding "4" onclick "q=area&name=colors"
+ text in "area-colors" label "Colors"
+ layout id "main" in "base" flow "horizontal-stretch" span "1"
+ box id "content" in "main" flow "vertical-stretch" padding "2" overflow "scroll" span "1"
+ layout id "bottom" in "base" flow "horizontal" spacing "2"
+ button id "save" in "bottom" mode "disabled" label "Save" onclick "q=save"
+ button in "bottom" label "Apply" onclick "q=apply"
