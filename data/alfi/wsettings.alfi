+ window id "window" label "Settings"
+ panel id "base" in "window" flow "vertical-stretch" padding "12" spacing "8" span "1"
+ layout id "languages-list" in "base" flow "horizontal" spacing "8"
+ text in "languages-list" wrap "word" span "1" label "Language"
+ select id "languages" in "languages-list" label "English (en_US)"
+ panel id "languages-box" in "languages" flow "vertical-stretch" padding "4"
+ item id "language-enus" in "languages-box" padding "8" onclick "set language en_US"
+ text in "language-enus" label "English (en_US)"
+ item id "language-engb" in "languages-box" padding "8" onclick "set language en_GB"
+ text in "language-engb" label "English (en_GB)"
+ item id "language-svse" in "languages-box" padding "8" onclick "set language sv_SE"
+ text in "language-svse" label "Swedish (sv_SE)"
+ layout id "keyboardlayouts-list" in "base" flow "horizontal" spacing "8"
+ text in "keyboardlayouts-list" wrap "word" span "1" label "Keyboard layout"
+ select id "keyboardlayouts" in "keyboardlayouts-list" label "USA (qwerty_US)"
+ panel id "keyboardlayouts-box" in "keyboardlayouts" flow "vertical-stretch" padding "4"
+ item id "keyboard-qwertyus" in "keyboardlayouts-box" padding "8" onclick "set keyboard qwerty_US"
+ text in "keyboard-qwertyus" label "USA (qwerty_US)"
+ item id "keyboard-qwertyse" in "keyboardlayouts-box" padding "8" onclick "set keyboard qwerty_SE"
+ text in "keyboard-qwertyse" label "Sweden (qwerty_SE)"
+ item id "keyboard-dvorak" in "keyboardlayouts-box" padding "8" onclick "set keyboard dvorak"
+ text in "keyboard-dvorak" label "Dvorak (dvorak)"
+ layout id "mouse-acc-list" in "base" flow "horizontal" spacing "8"
+ text in "mouse-acc-list" wrap "word" span "1" label "Mouse acceleration"
+ text in "mouse-acc-list" weight "bold" wrap "word" label "Yes / No"
