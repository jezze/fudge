+ window id "window" label "Settings"
+ panel id "base" in "window" flow "vertical-stretch" padding "8" span "1"
+ layout id "languages-list" in "base" flow "horizontal" spacing "8"
+ text in "languages-list" wrap "word" span "1" label "Language"
+ select id "languages" in "languages-list" label "English (en_US)"
+ layout id "languages-box" in "languages" flow "vertical-stretch"
+ choice in "languages-box" label "English (en_US)" onclick "set language en_US"
+ choice in "languages-box" label "English (en_GB)" onclick "set language en_GB"
+ choice in "languages-box" label "Swedish (sv_SE)" onclick "set language sv_SE"
+ layout id "keyboardlayouts-list" in "base" flow "horizontal" spacing "8"
+ text in "keyboardlayouts-list" wrap "word" span "1" label "Keyboard layout"
+ select id "keyboardlayouts" in "keyboardlayouts-list" label "USA (qwerty_US)"
+ layout id "keyboardlayouts-box" in "keyboardlayouts" flow "vertical-stretch"
+ choice in "keyboardlayouts-box" label "USA (qwerty_US)" onclick "set keyboard qwerty_US"
+ choice in "keyboardlayouts-box" label "Sweden (qwerty_SE)" onclick "set keyboard qwerty_SE"
+ choice in "keyboardlayouts-box" label "Dvorak (dvorak)" onclick "set keyboard dvorak"
+ layout id "mouse-acc-list" in "base" flow "horizontal" spacing "8"
+ text in "mouse-acc-list" wrap "word" span "1" label "Mouse acceleration"
+ text in "mouse-acc-list" weight "bold" wrap "word" label "Yes / No"
