+ window id "window" label "Browser"
+ panel id "base" in "window" flow "vertical-stretch" padding "2" spacing "2" span "1"
+ layout id "top" in "base" flow "horizontal" spacing "2"
+ button id "back" in "top" label "<" mode "disabled" onclick "q=back"
+ button id "forward" in "top" label ">" mode "disabled" onclick "q=forward"
+ button id "reload" in "top" label "Reload" onclick "q=reload"
+ box id "addressbox" in "top" mode "edit" padding "3" span "1" onchange "q=address&url=" onenter "q=go&url="
+ text id "address" in "addressbox"
+ button in "top" label "Go" onclick "q=go"
+ button id "scheme" in "top" label "Dark" onclick "q=scheme"
+ box id "frame" in "base" flow "vertical" overflow "scroll" span "1" onresize "q=resize" onscroll "q=scroll" onclick "q=click"
+ media id "page" in "frame" mimetype "image/raw"
