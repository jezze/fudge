+ window id "window" label "Text Editor"
+ panel id "base" in "window" flow "vertical-stretch" padding "2" spacing "2" span "1"
+ layout id "top" in "base" flow "horizontal" spacing "2"
+ select id "wrap" in "top" label "None" onselect "q=wrap&wrap="
+ panel id "wrap-list" in "wrap" flow "vertical-stretch"
+ item id "wrap-none" in "wrap-list" padding "4"
+ text in "wrap-none" label "None"
+ item id "wrap-word" in "wrap-list" padding "4"
+ text in "wrap-word" label "Word"
+ item id "wrap-char" in "wrap-list" padding "4"
+ text in "wrap-char" label "Character"
+ box id "content" in "base" flow "vertical" padding "2" overflow "scroll" span "1" mode "edit"
+ layout id "bottom" in "base" flow "horizontal" spacing "2"
+ button in "bottom" label "Open" onclick "q=open"
+ button in "bottom" label "Save" onclick "q=save"
