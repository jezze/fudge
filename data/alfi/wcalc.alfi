+ window id "window" label "Calculator" flow "vertical-stretch"
+ textbox id "output" in "window" mode "readonly" flow "vertical-stretch"
+ text id "result" in "output" label "0" halign "right"
+ layout id "row1" in "window" flow "horizontal-stretch" span "1"
+ button in "row1" label "7" span "1" onclick "q=num&value=7"
+ button in "row1" label "8" span "1" onclick "q=num&value=8"
+ button in "row1" label "9" span "1" onclick "q=num&value=9"
+ button in "row1" label "/" span "1" onclick "q=div"
+ layout id "row2" in "window" flow "horizontal-stretch" span "1"
+ button in "row2" label "4" span "1" onclick "q=num&value=4"
+ button in "row2" label "5" span "1" onclick "q=num&value=5"
+ button in "row2" label "6" span "1" onclick "q=num&value=6"
+ button in "row2" label "x" span "1" onclick "q=mul"
+ layout id "row3" in "window" flow "horizontal-stretch" span "1"
+ button in "row3" label "3" span "1" onclick "q=num&value=3"
+ button in "row3" label "2" span "1" onclick "q=num&value=2"
+ button in "row3" label "1" span "1" onclick "q=num&value=1"
+ button in "row3" label "-" span "1" onclick "q=sub"
+ layout id "row4" in "window" flow "horizontal-stretch" span "1"
+ button in "row4" label "0" span "1" onclick "q=num&value=0"
+ button in "row4" label "." span "1" onclick "q=dot"
+ button in "row4" label "+" span "1" onclick "q=add"
+ button in "row4" label "=" span "1" onclick "q=sum"
