+ window id "window" label "File Manager"
+ panel id "base" in "window" flow "vertical-stretch" padding "2" spacing "2" span "1"
+ layout id "top" in "base" flow "horizontal" spacing "2"
+ select id "volume" in "top" label "Volume"
+ panel id "volume-list" in "volume" flow "vertical-stretch"
+ box id "pathbox" in "top" mode "edit" padding "3" span "1" onenter "q=abspath&path="
+ text id "path" in "pathbox"
+ button in "top" label "Up" onclick "q=up"
+ layout id "main" in "base" flow "horizontal-stretch" spacing "2" span "1"
+ box id "content" in "main" flow "vertical-stretch" overflow "scroll" span "1"
+ each id "rows" in "content" data "files" flow "vertical-stretch" onselect "q=select&count="
+ item id "row" in "rows" padding "1" spacing "2" onenter "q=relpath&path={path}" onselect "q=mark&row={key}&selected="
+ text in "row" valign "middle" mode "link" onclick "q=relpath&path={path}" label "{path}"
+ layout id "info" in "content" display "none" flow "vertical" padding "2" spacing "1"
+ text id "info-name" in "info" weight "bold"
+ text id "info-path" in "info"
+ text in "info" label "Type: File"
+ text id "info-size" in "info"
+ text id "info-id" in "info"
+ each id "actions" in "info" data "actions" flow "horizontal" spacing "2"
+ button in "actions" label "{label}" onclick "q=action&index={key}"
+ text id "notfound" in "content" display "none" label "Path not found"
+ layout id "bottom" in "base" flow "horizontal" spacing "2"
+ layout id "browse" in "bottom" flow "horizontal" spacing "2"
+ button id "copy" in "browse" mode "disabled" label "Copy" onclick "q=copy"
+ button id "cut" in "browse" mode "disabled" label "Cut" onclick "q=cut"
+ button id "paste" in "browse" mode "disabled" label "Paste" onclick "q=paste"
+ button id "delete" in "browse" mode "disabled" label "Delete" onclick "q=delete"
+ layout id "saveas" in "bottom" display "none" flow "horizontal" spacing "2" span "1"
+ box id "namebox" in "saveas" mode "edit" padding "3" span "1" onchange "q=name&name=" onenter "q=save&name="
+ text id "name" in "namebox"
+ button in "saveas" label "Save" onclick "q=save"
+ layout id "openas" in "bottom" display "none" flow "horizontal" spacing "2"
+ button id "open" in "openas" mode "disabled" label "Open" onclick "q=open"
