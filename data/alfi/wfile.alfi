+ window id "window" label "File Manager"
+ panel id "base" in "window" flow "vertical-stretch" padding "2" spacing "2" span "1"
+ layout id "top" in "base" flow "horizontal" spacing "2"
+ select id "volume" in "top" label "Volume"
+ panel id "volume-list" in "volume" flow "vertical-stretch"
+ item id "volume-initrd" in "volume-list" padding "4" onclick "q=abspath&path=initrd:"
+ text in "volume-initrd" label "initrd:"
+ item id "volume-mem" in "volume-list" padding "4" onclick "q=abspath&path=mem:"
+ text in "volume-mem" label "mem:"
+ box id "pathbox" in "top" mode "edit" padding "3" span "1" onenter "q=abspath&path="
+ text id "path" in "pathbox"
+ button in "top" label "Up" onclick "q=up"
+ layout id "main" in "base" flow "horizontal-stretch" spacing "2" span "1"
+ box id "content" in "main" flow "vertical-stretch" overflow "scroll" span "1" onselect "q=select&count="
+ layout id "bottom" in "base" flow "horizontal" spacing "2"
+ button id "copy" in "bottom" mode "disabled" label "Copy" onclick "q=copy"
+ button id "cut" in "bottom" mode "disabled" label "Cut" onclick "q=cut"
+ button id "paste" in "bottom" mode "disabled" label "Paste" onclick "q=paste"
+ button id "delete" in "bottom" mode "disabled" label "Delete" onclick "q=delete"
