+ window id "window" label "File Manager"
+ panel id "base" in "window" flow "vertical-stretch" padding "12" spacing "8" span "1"
+ layout id "top" in "base" flow "horizontal" spacing "8"
+ select id "volume" in "top" label "Volume"
+ panel id "volume-list" in "volume" flow "vertical-stretch" padding "4"
+ item id "volume-initrd" in "volume-list" padding "16" onclick "q=abspath&path=initrd:"
+ text in "volume-initrd" label "initrd:"
+ textbox id "pathbox" in "top" span "1" onenter "q=abspath&path="
+ text id "path" in "pathbox"
+ button in "top" label "Up" onclick "q=up"
+ layout id "main" in "base" flow "horizontal-stretch" spacing "8" span "1"
+ listbox id "content" in "main" mode "readonly" flow "vertical-stretch" overflow "vscroll" span "1"
+ layout id "bottom" in "base" flow "horizontal" spacing "8"
+ button in "bottom" label "Copy" onclick "q=copy"
+ button in "bottom" label "Cut" onclick "q=cut"
+ button in "bottom" label "Paste" onclick "q=paste"
+ button in "bottom" label "Delete" onclick "q=delete"
